<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/health"
    tools:context=".MainActivity">

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="600dp"
        android:backgroundTint="#33000000"
        app:cardCornerRadius="18dp"
        android:layout_marginLeft="16dp"
        android:layout_marginRight="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.5" >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:padding="14dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="14dp"
                android:text="Welcome User"
                android:textColor="#1F6F43"
                android:textSize="30sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Build healthy habits with us"
                android:textStyle="bold"
                android:textColor="#F1F5F2"
                android:textSize="20sp"/>
            <com.airbnb.lottie.LottieAnimationView
                android:layout_width="150dp"
                android:layout_height="150dp"
                app:lottie_rawRes="@raw/login"
                app:lottie_autoPlay="true"
                app:lottie_loop="true"
                android:layout_marginTop="12dp"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="left"
                android:layout_marginTop="10dp"
                android:text="Username"
                android:textColor="#2E2E2E"
                android:textStyle="bold" />

            <EditText
                android:id="@+id/et1"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/item_glass"
                android:hint="Enter username"
                android:paddingStart="16dp"
                android:textSize="15sp"
                android:paddingEnd="16dp"
                android:textColor="#1C1C1C"
                android:textColorHint="#5F6F65"/>

            <TextView
                android:layout_gravity="left"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textStyle="bold"
                android:layout_marginTop="4dp"
                android:text="Password"
                android:textColor="#2E2E2E"/>

            <EditText
                android:id="@+id/et2"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:background="@drawable/item_glass"
                android:hint="Enter password"
                android:inputType="numberPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#1C1C1C"
                android:textColorHint="#5F6F65"
                android:textSize="15sp" />

            <Button
                android:id="@+id/Continue"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:backgroundTint="#57BCFF"
                android:layout_marginTop="14dp"
                android:layout_marginBottom="2dp"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#FFFFFF"
                android:gravity="center"
                android:text="Continue"/>

            <TextView
                android:id="@+id/tvForgot"
                android:layout_width="match_parent"
                android:layout_height="48dp"
                android:gravity="end"
                android:text="Forgot Password?"
                android:clickable="true"
                android:focusable="true"/>
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="3dp"
                android:gravity="center"
                android:textStyle="bold"
                android:text="-----------------------------OR-----------------------------"/>
            <TextView
                android:id="@+id/signing"
                android:layout_width="wrap_content"
                android:layout_height="48dp"
                android:layout_marginTop="0dp"
                android:text="Don't have an account? Sign up."
                android:textStyle="bold"
                android:clickable="true"
                android:focusable="true"
                android:textColor="#262626"/>

        </LinearLayout>




    </androidx.cardview.widget.CardView>


</androidx.constraintlayout.widget.ConstraintLayout>